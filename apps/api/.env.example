# API environment example — copy to apps/api/.env.local (never commit real secrets)
APP_ENV=development
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
PUBLIC_UPLOAD_BASE_URL=http://127.0.0.1:8787/upload
PUBLIC_SUPPORT_EMAIL=support@example.com
PUBLIC_ENVIRONMENT=development
DATABASE_URL=postgres://moss:moss@127.0.0.1:5432/moss
SESSION_SECRET=replace-with-32-plus-char-dev-secret
KMS_KEY_ID=local-dev-key
OBJECT_STORAGE_BUCKET=moss-dev-uploads
OBJECT_STORAGE_SECRET_KEY=replace-with-dev-only-storage-secret
QUEUE_URL=memory://local-queue
PAYMENT_WEBHOOK_SECRET=replace-with-dev-webhook-secret
PROVIDER_TRANSPORT=encrypted-allowlisted
PROVIDER_HOST=provider.example.internal
PROVIDER_PORT=443
HOSTED_CHECKS_INCLUDED=40
DEVICE_LIMIT=2
ALLOW_INSECURE_DEFAULTS=false

# Resend (OTP emails) — set real values in apps/api/.env (never commit)
# Domain matrix-ae.com must be verified in Resend before team@matrix-ae.com works.
RESEND_API_KEY=re_replace_with_real_key_from_resend_dashboard
RESEND_FROM_EMAIL=team@matrix-ae.com
AUTH_STORE_PATH=./data/auth-store.json
# AUTH_RETURN_OTP=1  # local/dev only — never in production

# Google + Microsoft social sign-in (secrets belong on Railway @moss/api only)
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Admin dashboard
# Comma-separated list of emails allowed into the admin console.
ADMIN_EMAILS=admin@example.com

# Admin web app URL
ADMIN_WEB_ORIGIN=http://127.0.0.1:5174

# Server-only secret used to verify entitlement webhooks.
ENTITLEMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Persistent entitlement ledger.
ENTITLEMENT_STORE_PATH=./data/entitlements-store.json