{
  "name": "moss-plag-extension",
  "private": true,
  "version": "0.0.0",
  "description": "Code similarity workflow extension monorepo (Matrix-AE)",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "pretest": "node scripts/check-node-version.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:domain": "node --test tests/prompt-011-domain-model.test.js",
    "test:e2e:chrome": "node scripts/e2e/chrome-popup-e2e.mjs",
    "pretypecheck": "node scripts/check-node-version.js",
    "typecheck": "tsc -b --pretty false",
    "prelint": "node scripts/check-node-version.js",
    "lint": "node scripts/check-workspaces.js && node scripts/check-boundaries.js",
    "typecheck:extension": "npm run typecheck --workspace @moss/extension",
    "prebuild": "node scripts/check-node-version.js",
    "build": "tsc -b --pretty false && npm run build:extension",
    "build:extension": "npm run build --workspace @moss/extension",
    "zip:extension": "npm run zip --workspace @moss/extension",
    "icons:extension": "node scripts/generate-extension-icons.js",
    "check:runtime": "node scripts/check-node-version.js",
    "check:deps": "node scripts/check-dependencies.js",
    "check:extension": "node scripts/check-extension-build.js",
    "api:start": "npm run start --workspace @moss/api",
    "api:start:live": "npm run start:live --workspace @moss/api",
    "api:start:mock": "npm run start:mock --workspace @moss/api",
    "release:dry-run": "node scripts/release/dry-run.js",
    "format": "node scripts/check-editorconfig.js",
    "format:check": "node scripts/check-editorconfig.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3"
  }
}
