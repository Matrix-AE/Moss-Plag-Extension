{
  "name": "moss-plag-extension",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "moss-plag-extension",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22",
        "npm": ">=10"
      }
    },
    "apps/api": {
      "name": "@moss/api",
      "version": "0.0.0",
      "dependencies": {
        "@moss/contracts": "0.0.0",
        "@moss/domain": "0.0.0"
      }
    },
    "apps/extension": {
      "name": "@moss/extension",
      "version": "0.0.0",
      "dependencies": {
        "@moss/contracts": "0.0.0",
        "@moss/domain": "0.0.0",
        "@moss/ui": "0.0.0"
      }
    },
    "apps/worker-cleanup": {
      "name": "@moss/worker-cleanup",
      "version": "0.0.0",
      "dependencies": {
        "@moss/contracts": "0.0.0"
      }
    },
    "apps/worker-submit": {
      "name": "@moss/worker-submit",
      "version": "0.0.0",
      "dependencies": {
        "@moss/contracts": "0.0.0",
        "@moss/domain": "0.0.0",
        "@moss/provider-adapter": "0.0.0"
      }
    },
    "node_modules/@moss/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@moss/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@moss/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@moss/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@moss/provider-adapter": {
      "resolved": "packages/provider-adapter",
      "link": true
    },
    "node_modules/@moss/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@moss/worker-cleanup": {
      "resolved": "apps/worker-cleanup",
      "link": true
    },
    "node_modules/@moss/worker-submit": {
      "resolved": "apps/worker-submit",
      "link": true
    },
    "packages/contracts": {
      "name": "@moss/contracts",
      "version": "0.0.0"
    },
    "packages/domain": {
      "name": "@moss/domain",
      "version": "0.0.0"
    },
    "packages/provider-adapter": {
      "name": "@moss/provider-adapter",
      "version": "0.0.0",
      "dependencies": {
        "@moss/contracts": "0.0.0",
        "@moss/domain": "0.0.0"
      }
    },
    "packages/ui": {
      "name": "@moss/ui",
      "version": "0.0.0"
    }
  }
}
